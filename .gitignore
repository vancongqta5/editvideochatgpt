# 1. Bỏ qua thư mục thư viện nặng của Node.js & Remotion
**/node_modules/
**/.remotion/
**/dist/
**/build/

# 2. Bỏ qua toàn bộ file video/âm thanh gốc và file xuất ra
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
data/source/*
!data/source/.gitkeep
data/final/*
!data/final/.gitkeep
**/out/
**/public/input.mp4

# 3. Bỏ qua file tạm của Python và hệ thống
**/__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Venv whisper của project
.venv-whisper/


# Metadata IDE và agent harness — không phải mã nguồn
.openidea/
.omp/
**/.env
*.bak

# Bỏ qua dữ liệu dự án cá nhân
data/projects/*
!data/projects/.gitkeep
data/active-project.json
